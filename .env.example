# =================================================================
# INTERVIEW PREPARATION BOARD - ENVIRONMENT CONFIGURATION
# =================================================================

# Server Port
PORT=5000
NODE_ENV=development

# JWT Authentication Secret Key
JWT_SECRET=super_secret_jwt_interview_prep_board_key_2026_xyz

# Judge0 Code Execution API (Optional - remote sandbox cluster)
# If omitted, the server uses the built-in isolated code execution service
RAPIDAPI_JUDGE0_KEY=
JUDGE0_HOST=https://judge0-ce.p.rapidapi.com

# AI Mock Interview Engine (Optional)
# If omitted, the platform uses its built-in NLP heuristics and STAR evaluator
OPENAI_API_KEY=
GEMINI_API_KEY=

# Supabase / PostgreSQL Database Connection (Optional)
# By default, local persistent JSON database is used in server/data/db.json
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
